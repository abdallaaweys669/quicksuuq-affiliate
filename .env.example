# Supabase > Project Settings > Database > Connection string (Node.js / URI)
# Use the direct connection or session pooler for server-side Next.js runtime.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Shopify webhook verification (never expose these as NEXT_PUBLIC variables)
SHOPIFY_API_SECRET=replace_with_shopify_app_client_secret
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Optional: set true only for local webhook tests with a verified test fixture.
# Never disable signature verification in production.
ALLOW_UNSIGNED_WEBHOOKS=false
